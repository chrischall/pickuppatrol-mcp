{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.chrischall/pickuppatrol-mcp",
  "description": "Read and change your children's school dismissal plans in PickUp Patrol",
  "repository": {
    "url": "https://github.com/chrischall/pickuppatrol-mcp",
    "source": "github"
  },
  "version": "1.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@chrischall/pickuppatrol-mcp",
      "version": "1.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PICKUPPATROL_USERNAME",
          "description": "The email address you sign in to app.pickuppatrol.net with",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "PICKUPPATROL_PASSWORD",
          "description": "Your PickUp Patrol password",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
